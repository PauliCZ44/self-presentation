---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import { locales, useTranslations, type Locale } from "../i18n";

const flags: Record<Locale, string> = {
  en: "circle-flags:gb",
  cs: "circle-flags:cz",
};

const t = useTranslations(Astro.currentLocale);
const current = Astro.currentLocale;
---

<nav
  class="fixed top-4 right-4 z-20 flex gap-1 rounded-md px-2 py-1 font-mono text-sm language-switcher"
  aria-label={t.languageSwitcher.label}
>
  {
    locales.map((l) => (
      <a
        href={getRelativeLocaleUrl(l)}
        hreflang={l}
        lang={l}
        data-lang={l}
        aria-current={l === current ? "true" : undefined}
        class:list={[
          "flex items-center px-1 uppercase",
          l === current ? "text-primary font-bold" : "text-white opacity-60 hover:opacity-100",
        ]}
      >
        <span class="flag">
          <Icon name={flags[l]} width={18} height={18} aria-hidden="true" />
        </span>
        {l}
      </a>
    ))
  }
</nav>

<script>
  // Remember an explicit choice so it overrides browser-language sniffing on the next visit.
  document.querySelectorAll<HTMLAnchorElement>("[data-lang]").forEach((link) => {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem("lang", link.dataset.lang!);
      } catch {}
    });
  });
</script>

<style>
  .language-switcher {
    /* 0 at the top, 1 after scrolling half a screen; --scrollY and --windowHeight are set on body by the page script. */
    --progress: clamp(0, var(--scrollY, 0) / (var(--windowHeight, 800) * 0.5), 1);
    opacity: calc(1 - 0.5 * var(--progress));
    background: rgba(0, 0, 0, 0.5);
    box-shadow:
      0px 0px 80px 0px hsl(var(--primary-hsl) / 30%),
      0px 0px 6px 2px hsl(var(--primary-hsl) / 60%);
  }

  .flag {
    display: flex;
    overflow: hidden;
    opacity: calc(1 - var(--progress));
    width: calc(18px * (1 - var(--progress)));
    margin-right: calc(6px * (1 - var(--progress)));
  }
</style>
