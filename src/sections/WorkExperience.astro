---
import { useTranslations } from "../i18n";

const experiences = useTranslations(Astro.currentLocale).experience;
---

<div class="pt-36 pb-36 w-full bg-gradient-custom">
  <ol
    class="max-w-xl w-10/12 sm:w-8/12 md:w-6/12 m-auto border-l-4 pl-8 blue-border flex flex-col gap-24"
  >
    {
      experiences.map(({ description, title, date }) => (
        <li class="relative pl-4">
          <div class="reavel-dot border-primary border-2 w-8 h-8 bg-primary shadow-inner shadow-black rounded-full -left-12 translate-x-[-2px] top-1/2 -translate-y-1/2 absolute" />
          <h4 class="text-lg font-bold reveal-text pb-2">{title}</h4>
          <h6 class="text-base text-content reveal-text pb-2">{date}</h6>
          <p class="text-sm text-content-secondary reveal-text">
            {description}
          </p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .reveal-text,
  .reavel-dot {
    /* Create View Timeline */
    view-timeline-name: --revealing-text;
    view-timeline-axis: block;

    /* Attach animation, linked to the  View Timeline */
    animation: ease revealText both;
    animation-timeline: --revealing-text;

    /* Tweak range when effect should run*/
    animation-range: entry 5% cover 45%;
  }
  .reavel-dot {
    view-timeline-name: --revealing-dot;
    view-timeline-axis: block;
    animation: ease revealDot both;
    animation-timeline: --revealing-dot;
    animation-range: entry 5% cover 45%;
  }

  @keyframes revealText {
    from {
      opacity: 0;
      transform: translateX(-50px) scale(0.85);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes revealDot {
    from {
      scale: 0.5;
      box-shadow: inset 0 0 0 black;
    }
    to {
      scale: 1;
      box-shadow: inset 0 2px 4px 0 black;
    }
  }
</style>
