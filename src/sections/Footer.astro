---
import { Icon } from "astro-icon/components";
import { useTranslations } from "../i18n";
import { CONTACT_EMAIL } from "../constants";

const t = useTranslations(Astro.currentLocale);
const links = [
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/pavel-stastny-155539150",
    icon: "simple-icons:linkedin",
  },
  {
    name: "GitHub",
    href: "https://github.com/PauliCZ44",
    icon: "simple-icons:github",
  },
  {
    name: "FCC",
    href: "https://www.freecodecamp.org/paulicz44",
    icon: "simple-icons:freecodecamp",
  },
];
---

<footer id="footer" class="pt-16 pb-8 square-bg">
  <div class="container px-6 sm:px-20 mx-auto text-gray-300">
    <div
      class="font-sans text-sm font-semibold flex gap-x-10 gap-y-8 sm:gap-x-32 flex-wrap"
    >
      <div class="">
        <p class="fs-base font-bold text-gray-50 mb-11">{t.footer.links}</p>
        <div class="flex flex-col gap-2">
          {
            links.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center leading-relaxed group-link"
              >
                <Icon name={l.icon} height="1rem" width="1rem" aria-hidden="true" />
                <span class="ml-2 link">{l.name}</span>
              </a>
            ))
          }
        </div>
      </div>
      <div class="max-w-[70ch]">
        <p class="fs-base font-bold text-gray-50 mb-11">{t.footer.aboutPage}</p>
        <p class="leading-relaxed opacity-80">
          {t.footer.aboutPageText}
        </p>
        <div class="mt-8">
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="inline-flex items-center leading-relaxed group-link"
          >
            <Icon
              height="1rem"
              width="1rem"
              class="mr-3 mt-0.5"
              name="lucide:mail"
              aria-hidden="true"
            />
            <span class="link relative">{CONTACT_EMAIL}</span>
          </a>
        </div>
      </div>
      <p class="text-right text-xs text-zinc-400 self-end flex-1">
        &copy; Copyright {new Date().getFullYear()} Pavel Šťastný. {t.footer.rights}
      </p>
    </div>
  </div>
</footer>
