---
import { Image } from "astro:assets";
import bang from "../assets/Bangcalc.jpg";
import drums from "../assets/drums.jpg";
import cestaky from "../assets/cestaky.jpg";
import svelte from "../assets/svelte.jpg";
import pomodoro from "../assets/timer.jpg";
import pedikura from "../assets/pedikura.jpg";
import { Icon } from "astro-icon/components";
import { useTranslations } from "../i18n";

type Projects = Array<{img: ImageMetadata, title: string, href: string, content: string, tech: string, sourceCode?: string, note?: string, ai?: boolean}>

const { ai = false } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const tp = t.projects;

const projects:  Projects = [
  {
    img: bang,
    title: "BANG! Score Calculator",
    href: "https://bangcalc.netlify.app/",
    content: tp.items.bang.content,
    sourceCode: "https://github.com/PauliCZ44/Bang-Calc",
    tech: "React, Bootstrap",
  },
  {
    img: cestaky,
    title: "Cesťáky",
    href: "https://cestaky-app.web.app/",
    content: tp.items.cestaky.content,
    sourceCode: "https://github.com/PauliCZ44/cestaky-app",
    tech: "React, Mantine, Firebase",
  },
  {
    img: svelte,
    title: "Svelte Calculator",
    href: "https://paulicz44.github.io/Calculator-svelte/",
    sourceCode: "https://github.com/PauliCZ44/Calculator-svelte",
    content: `
    ${tp.items.svelte.content}
    <br/>
    <br/>
    <div class="px-6 text-content">
      <details class="details inline relative cursor-pointer">
        <summary class="link"><b>${tp.svelteOpinionLabel}</b></summary>
        <small> 
          ${tp.items.svelte.opinion}
        </small>
      </details>
    </div>
   `,
    tech: "Svelte 4, Carbon Design System, SASS"
  },
  {
    img: drums,
    title: "Drum & Beats",
    href: "https://drumsandbeats.netlify.app/beats",
    content: tp.items.drums.content,
    sourceCode: "https://github.com/PauliCZ44/drum-machine",
    tech: "React, Typescript, Tailwind, DaisyUI, Vite",
  },
  {
    img: pomodoro,
    title: "Pomodoro timer",
    href: "https://pomodorosimple.netlify.app/",
    content: tp.items.pomodoro.content,
    sourceCode: "https://github.com/PauliCZ44/pomodoro-timer",
    tech: "React, Tailwind, DaisyUI",
  },
  {
    img: pedikura,
    title: "Nožky od Marušky",
    href: "https://simova-mobilni-pedikura.pages.dev/",
    content: tp.items.pedikura.content,
    tech: tp.items.pedikura.tech,
    ai: true,
  },
];

const visibleProjects = projects.filter((proj) => !!proj.ai === ai);
---

<section class="text-white bg-gradient-custom py-36">
  <div class="row mt text-center">
    <div class="w-10/12 sm:w-8/12 md:w-6/12 m-auto pb-8">
      {
        ai ? (
          <p class="text-content-secondary">{tp.introAi}</p>
        ) : (
          <p class="text-content-secondary">{tp.introHandwritten}</p>
        )
      }
    </div>
  </div>
 
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-12 xl:gap-16 mt-8 w-11/12 xl:w-10/12 mx-auto max-w-5xl justify-items-center"
  >
    {
      visibleProjects.map((proj, i) => (
        <div
          style={`--offset: ${(i + 2) % 2}`}
          class="overflow-hidden image-wrapper flex flex-col gap-3 items-start border-primary-opacity-50 hover:border-primary-opacity-75 border rounded-sm max-w-md scroll-reveal-test"
        >
          <a href={proj.href}>
            <Image
              class="rounded-t-sm"
              src={proj.img}
              alt={tp.imageAlt + " " + proj.title}
            />
          </a>
          <h3 class="px-6 pt-2 font-mono text-2xl font-bold">{proj.title}</h3>
          <div class="px-6 text-content-secondary" set:html={proj.content} />
          <div class="px-6">
            <span class="opacity-80 text-sm font-semibold">{tp.technologies}</span>{" "}
            <b class="opacity-80 text-sm font-semibold">{proj.tech}</b>
          </div>
          <div class="px-6 pb-6 flex gap-6 justify-end self-end mt-auto">
            {proj.sourceCode && (
              <div data-wenk={tp.sourceCode}>
                <a
                  class="link--btn link"
                  href={proj.sourceCode}
                  aria-label={`${tp.sourceCode}: ${proj.title}`}
                >
                  <Icon name="simple-icons:github" height={24} width={32} aria-hidden="true" />
                </a>
              </div>
            )}
            <div data-wenk={tp.openDemo}>
              <a
                class="link--btn link"
                href={proj.href}
                aria-label={`${tp.openDemo}: ${proj.title}`}
              >
                <Icon name="ic:outline-open-in-new" height={24} width={32} aria-hidden="true" />
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style lang="scss">
  .image-wrapper {
    img {
      transition: all 0.155s cubic-bezier(0.37, 0, 0.63, 1);
    }
    img:hover {
      scale: 1.05;
      rotate: -1deg;
    }
    a {
      overflow: hidden;
    }
  }
  

  .scroll-reveal-test {
    /* Create View Timeline */
    view-timeline-name: --revealing-image;
    view-timeline-axis: block;

    /* Attach animation, linked to the  View Timeline */
    animation: ease reveal both;
    animation-timeline: --revealing-image;

    /* Tweak range when effect should run*/
    animation-range: entry calc(5% + 10% * var(--offset, 1)) cover
      calc(60% + 5% * var(--offset, 1));
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(calc(200px + 100px * var(--offset))) scale(0.85);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
